# Optional manual configuration; prefer node scripts/setup.mjs plan/install.
# Auto-detect common installation locations; explicitly choose ambiguous candidates.
WORKBUDDY_BACKEND=desktop-queue
# WORKBUDDY_NODE_BIN=C:/Program Files/nodejs/node.exe
# WORKBUDDY_CLI_ELECTRON=D:/Apps/WorkBuddy/WorkBuddyAI.exe
# WORKBUDDY_CONFIG_DIR=C:/Users/YOUR_USER/.workbuddy-ai
# Optional free-only restriction; no fixed model is selected by default.
# Set only when the user explicitly requests this restriction.
# WORKBUDDY_REQUIRED_FREE_MODEL=<user-approved-free-model-id>
WORKBUDDY_MAX_TASK_ATTEMPTS=3
WORKBUDDY_CLAIM_TIMEOUT_SECONDS=180

# Optional quota observation for workbench-entry only; off unless URL is set.
# Set these privately in the process environment; never commit real values.
# Use an explicit loopback origin without /v1. No automatic login/probe occurs.
# WORKBUDDY_QUOTA_SOURCE_ID=workbuddy2api-local
# WORKBUDDY_QUOTA_SOURCE_URL=http://127.0.0.1:8788
# WORKBUDDY_QUOTA_API_KEY=YOUR_PRIVATE_API_KEY
# WORKBUDDY_QUOTA_PANEL_TOKEN=YOUR_EXISTING_PANEL_SESSION_TOKEN

# Optional cached credit summaries (separate from token estimates).
# Requires /v1/balance-summary on the source; no panel token or login is used.
# WORKBUDDY_CREDIT_SOURCE_ID=workbuddy2api-credit
# WORKBUDDY_CREDIT_SOURCE_URL=http://127.0.0.1:8788
# WORKBUDDY_CREDIT_API_KEY=YOUR_EXISTING_DSH_PROVIDER_API_KEY

# Optional DSH adapter, off by default. Does not authorize a model or plan.
# WORKBUDDY_DSH_ENABLED=1
# WORKBUDDY_DSH_HOST_ID=dsh-<verified-host-id>
# WORKBUDDY_DSH_PROVIDER_ID=<exact-provider-id>
# WORKBUDDY_DSH_RATE_SOURCE_URL=http://127.0.0.1:8788
# WORKBUDDY_DSH_RATE_API_KEY=<existing-private-key-for-that-provider-route>
# WORKBUDDY_DSH_REGISTRY_DIR=<private-bridge-host-registry-directory>
