{
  "name": "codex-workbuddy-gateway",
  "version": "0.7.1",
  "private": true,
  "description": "Local Agent Hub with HTTP, MCP, SDK, CLI and a workbench; WorkBuddy executor and existing Harness bridge.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck:task-view": "tsc -p tsconfig.task-view.json",
    "start": "node dist/server.js",
    "hub": "./bin/agent-hub serve",
    "workbench": "node dist/workbench-entry.js",
    "desktop": "node scripts/open-workbench.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:test": "dotnet run --project desktop/test/PolicyTests.csproj --configuration Release",
    "test:workbench": "node --test workbench/test/*.test.mjs",
    "probe:pages": "node workbench/test/page-layout-probe.mjs",
    "readiness": "node scripts/readiness.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "hub:mcp": "./bin/agent-hub-mcp",
    "auth": "node dist/auth.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test test/**/*.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "verification:preflight": "node scripts/verification-preflight.mjs",
    "package": "node scripts/package.mjs",
    "release:pairing": "node scripts/verify-pairing.mjs",
    "release:candidate": "node scripts/candidate-installation.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "skill:sync": "node scripts/sync-skill.mjs --write",
    "skill:check": "node scripts/sync-skill.mjs --check",
    "acceptance:check": "node scripts/check-acceptance-matrix.mjs",
    "deepseek:start": "node dist/deepseek-server.js",
    "deepseek:skill:install": "node scripts/install-deepseek-skill.mjs",
    "deepseek:plugin:install": "node scripts/install-deepseek-plugin.mjs",
    "deepseek:plugin:test": "node --test deepseek-plugin/test/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "deployment:check": "node scripts/deployment-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
